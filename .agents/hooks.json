{
  "auto-deploy": {
    "PostToolUse": [
      {
        "matcher": "multi_replace_file_content|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "npm run deploy > NUL 2>&1 & echo {}",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
